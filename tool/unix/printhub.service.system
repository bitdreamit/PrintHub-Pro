# PrintHub Pro - SYSTEM service unit template (Linux + systemd)
# Installed by:  sudo bash install-unix.sh --service
#            or:  the printhub-pro .deb -> /usr/lib/systemd/system/printhub.service
# __PYTHON__ / __HUB__ are substituted by the installer at install time.
# Runs as root with data in /var/lib/printhub so it works before any
# login (a real "run as service" - survives reboot, no desktop needed).
# Per-user alternative: systemctl --user enable --now printhub

[Unit]
Description=PrintHub Pro - local print hub (system service)
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=__PYTHON__ __HUB__ serve
WorkingDirectory=/var/lib/printhub
Environment=PRINTHUB_DATA=/var/lib/printhub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
