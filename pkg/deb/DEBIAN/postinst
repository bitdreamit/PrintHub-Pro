#!/bin/sh
# best-effort: enable the systemd user service for the installing user.
# EVERYTHING here is guarded - a postinst failure would mark the package broken.
if [ "$1" = "configure" ]; then
    TARGET="${SUDO_USER:-$LOGNAME}"
    if [ -n "$TARGET" ] && [ "$TARGET" != "root" ] && command -v systemctl >/dev/null 2>&1; then
        TUID="$(id -u "$TARGET" 2>/dev/null || true)"
        if [ -n "$TUID" ] && [ -d "/run/user/$TUID" ]; then
            sudo -u "$TARGET" XDG_RUNTIME_DIR="/run/user/$TUID" \
                systemctl --user daemon-reload 2>/dev/null || true
            sudo -u "$TARGET" XDG_RUNTIME_DIR="/run/user/$TUID" \
                systemctl --user enable --now printhub 2>/dev/null || true
            loginctl enable-linger "$TARGET" 2>/dev/null || true
        fi
    fi
    echo "---------------------------------------------"
    echo " PrintHub Pro installed."
    echo "   hub        : http://127.0.0.1:9235  (token: PrintHub-2024)"
    echo "   control    : systemctl --user status|stop|restart printhub"
    echo "   enable now : systemctl --user enable --now printhub"
    echo "   CLI        : printhub doctor | printers | testprint a4"
    echo "   Chrome     : load the extension/ folder from the companion ZIP"
    echo "---------------------------------------------"
fi
exit 0
